{
  "name": "omniconvert-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OmniConvert Pro — 3-Tier Hybrid Local-First Universal File Converter (Capacitor iOS + Rust Core + Zero-Knowledge Cloud Worker)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && npx cap sync ios",
    "audit:store": "python scripts/store_preflight_audit.py"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.77.0",
    "marked": "^18.2.1",
    "papaparse": "^5.7.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
